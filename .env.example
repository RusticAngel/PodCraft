# ==== Google Cloud ====
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=./credentials.json

# ==== Gemini API (required: agent reasoning, TTS, sentiment, Lyria music) ====
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash
# Optional: dedicated TTS model (default: gemini-2.5-flash-preview-tts)
GEMINI_TTS_MODEL=

# ==== Lyria 3 (music generation) ====
# Uses GEMINI_API_KEY on the paid tier. Model ID configurable:
LYRIA_MODEL=lyria-3-clip-preview

# ==== Parallel Search (free for OpenCode agents) ====
PARALLEL_API_KEY=your-parallel-key  # Optional

# ==== Cloud Run ====
CLOUD_RUN_URL=your-cloud-run-url

# ==== TTS Configuration (Gemini-native audio output voices) ====
DEFAULT_TTS_VOICE=Puck
SECONDARY_TTS_VOICE=Charon